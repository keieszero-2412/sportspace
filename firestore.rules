rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /Facilities/{id} { allow read: if true; allow write: if false; }
    match /Courts/{id} { allow read: if true; allow write: if false; }
    match /Users/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /Bookings/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid || admin());
      allow write: if false;
    }
    match /Availability/{id} { allow read: if true; allow write: if false; }
    match /Matches/{id} { allow read: if true; allow write: if false; }
    match /Reviews/{id} { allow read: if true; allow write: if false; }
    match /Notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
    }
    match /CredibilityEvents/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid; }
    match /MerchantApplications/{uid} { allow read: if signedIn() && (request.auth.uid == uid || admin()); }
    match /{document=**} { allow read, write: if false; }
  }
}
