# Chỉ bật emulator ở môi trường phát triển; không dùng service account trong VITE_*.
VITE_USE_EMULATORS=false

# Frontend authentication now uses Supabase. Use the public anon/publishable key.
# Never put a service_role key, database password or OAuth secret in VITE_*.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
